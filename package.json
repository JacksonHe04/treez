{
  "name": "treez",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "dev:worker": "wrangler dev",
    "build": "next build",
    "build:worker": "wrangler deploy --dry-run --env production",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "check": "tsc --noEmit",
    "check:worker": "wrangler types --check",
    "db:migrate:local": "wrangler d1 migrations apply treez-production --local",
    "db:migrate:remote": "wrangler d1 migrations apply treez-production --remote --env production",
    "import:notion:dry-run": "tsx scripts/import-notion.ts",
    "assets:supabase:dry-run": "tsx scripts/backfill-supabase-assets.ts",
    "assets:supabase:apply": "tsx scripts/backfill-supabase-assets.ts --apply"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@inon-ai/inon-sso": "0.1.0",
    "@reduxjs/toolkit": "^2.7.0",
    "@supabase/supabase-js": "2.110.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "hono": "^4.12.32",
    "lucide-react": "^1.27.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-redux": "^9.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tailwindcss/postcss": "^4.1.5",
    "@types/node": "^22.14.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.23.0",
    "eslint-config-next": "16.2.9",
    "globals": "^15.15.0",
    "prettier": "^3.5.3",
    "shadcn": "^4.15.0",
    "tailwindcss": "^4.1.5",
    "tsx": "^4.23.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "wrangler": "^4.114.0"
  }
}
